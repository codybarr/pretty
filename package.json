{
	"name": "pretty",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "bunx --bun @biomejs/biome check --write",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "biome check src scripts biome.json package.json vite.config.ts && node scripts/check-tailwind-classes.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@ark-ui/svelte": "^5.24.2",
		"@tabler/icons-svelte": "^3.48.0",
		"@tailwindcss/vite": "^4.3.3",
		"class-variance-authority": "^0.7.1",
		"tailwindcss": "^4.3.3"
	}
}
